# Copy to .env (API, worker) — every value is optional for offline local dev.

# fake (offline, deterministic) | foundry (Azure AI Foundry)
MODEL_PROVIDER=fake
# e.g. https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=
# Override a role's deployment without editing config/models.yaml:
# MODEL_RUN_DEPLOYMENT=gpt-6.1-sol

DATABASE_URL=postgresql+asyncpg://ecosys:ecosys@localhost:5432/ecosys
REDIS_URL=redis://localhost:6379/0

# dev | entra
AUTH_MODE=dev
DEV_JWT_SECRET=dev-only-secret-change-me-dev-only-secret
ENTRA_TENANT_ID=
ENTRA_TENANT_SUBDOMAIN=
ENTRA_API_CLIENT_ID=
BOOTSTRAP_ADMINS=admin@ecosys.dev
